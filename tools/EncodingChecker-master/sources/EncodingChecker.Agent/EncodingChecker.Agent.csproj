<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>EncodingChecker.Cli</AssemblyName>
    <Version>3.15.1</Version>
    <InformationalVersion>3.15.1+agent.1</InformationalVersion>
    <Nullable>enable</Nullable>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <!-- Reference the GUI assembly as an API library; never launch its apphost. -->
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\EncodingChecker\EncodingChecker.csproj" AdditionalProperties="SelfContained=false" />
  </ItemGroup>
</Project>
